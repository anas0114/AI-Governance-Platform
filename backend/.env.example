# App
APP_NAME=AI Governance Platform API
ENVIRONMENT=development
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Database
DATABASE_URL=postgresql+asyncpg://aigov:aigov@localhost:5432/aigov

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_POLICIES=policies
CHROMA_COLLECTION_REGULATIONS=regulations
CHROMA_COLLECTION_EVIDENCE=evidence
CHROMA_COLLECTION_INDUSTRY_STANDARDS=industry_standards
CHROMA_COLLECTION_AUDIT_FINDINGS=audit_findings
CHROMA_COLLECTION_GOVERNANCE_DOCUMENTS=governance_documents
CHROMA_PERSIST_DIR=./chroma_data

# LLM Provider
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# LangSmith tracing/observability (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=ai-governance-platform
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

